# ==== [Testing] ====
# An additional setting for testing to save on performance of downloading the jars when building the image
DOWNLOAD_JARS = true

# ==== [Python] ====
PYTHON_VERSION=3.12.12

# ==== [Local Development] ====
IS_LOCAL=True
ENV_CODE=local
FAPC=False
TRACE_ENV=unspecified
PROJECT_LOG_DIR=brus_backend_common/logs

# ==== [AWS] ====
AWS_ACCESS_KEY=minio_user
AWS_SECRET_KEY=minio_secret
#AWS_PROFILE=
AWS_REGION=us-gov-west-1

# ==== [Buckets] ====
DATA_ARCHIVE_BUCKET=data-archive-test
DATA_EXTRACTS_BUCKET=data-extracts-test
DATA_SOURCES_BUCKET=data-sources-test
FPDS_DELETE_BUCKET=fpds-delete-test
METRICS_BUCKET=metrics-test
PUBLIC_FILES_BUCKET=public-files-test
PUBLISHED_BUCKET=published-test
SF133_BUCKET=sf133-test
SUB_ZIPS_BUCKET=sub-zips-test
UNPUBLISHED_BUCKET=unpublished-test

# Lakehouse Buckets
LAKEHOUSE_BROKER_BUCKET=broker-test
LAKEHOUSE_REFERENCE_BUCKET=reference-test
LAKEHOUSE_USAS_BUCKET=usas-test

# ==== [Postgres] ====
DB1_URL=
DB2_URL=

# ==== [Metastore] ====
METASTORE_URL=

# ==== [Spark] ====
JAVA_VERSION=1.8.0  # bump to 17 later
SPARK_VERSION=3.4.1
HADOOP_VERSION=3.3.4  # EMR uses a patched 3.3.6 but the unpatched version seems to break things
SCALA_VERSION=2.12
DELTA_VERSION=2.4.0

SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=4040
SPARK_HISTORY_SERVER_PORT=18080

# ==== [MinIO] ====
MINIO_HOST=minio
MINIO_PORT=10001
MINIO_CONSOLE_PORT=10002
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_secret
MINIO_DATA_DIR=$HOME/Development/data/brus-backend-common/docker/brus-backend-common-s3
